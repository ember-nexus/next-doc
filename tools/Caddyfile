:80 {
	root * /srv
	file_server
	try_files {path} {path}/index.html

	encode {
		zstd better
		gzip 6
		minimum_length 256
	}

	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /pagefind/pagefind-*.* Cache-Control "public, max-age=31536000, immutable"
	header /pagefind/* ?Cache-Control "public, max-age=3600"
	header /open-graph/* ?Cache-Control "public, max-age=604800"
	header /llms.txt Content-Type "text/markdown; charset=utf-8"
	header /*.ico ?Cache-Control "public, max-age=604800"
	header /*.png ?Cache-Control "public, max-age=604800"
	header /*.svg ?Cache-Control "public, max-age=604800"
	header /*.webmanifest ?Cache-Control "public, max-age=604800"

	# Every HTML page has a `*.md` twin (see [...slug].md.ts et al.) meant for
	# LLM/agent consumption, not search results — it's the same content as
	# its HTML page, so it must never rank or get cached as a separate result.
	# `Link: rel="canonical"` points search engines back at the HTML page,
	# and `X-Robots-Tag` keeps the duplicate out of the index entirely.
	@markdown path_regexp md ^(.*)\.md$
	header @markdown {
		Content-Type "text/markdown; charset=utf-8"
		Link "<{http.regexp.md.1}>; rel=\"canonical\""
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	# The one exception: "index.md" is the markdown twin of "/", not "/index".
	header /index.md Link "</>; rel=\"canonical\""

	header {
		?Cache-Control "public, max-age=0, must-revalidate"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_errors 404 {
		# Unresolved `*.md` requests get the markdown 404 (see [404.md.ts]),
		# so an LLM/agent fetching a bad path gets markdown back, not HTML.
		@error_md path_regexp errormd \.md$
		handle @error_md {
			header Content-Type "text/markdown; charset=utf-8"
			header X-Robots-Tag "noindex, nofollow, noarchive"
			rewrite * /404.md
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}
