{
  "openapi": "3.1.1",
  "info": {
    "title": "Ember Nexus API",
    "version": "0.1.31"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token for user authentication. If omitted, the request is processed as an anonymous user; if provided, the associated user account is used.",
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Authorization",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/authorization",
            "name": "HTTP.dev"
          }
        ]
      }
    }
  }
}
