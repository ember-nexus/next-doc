{
  "openapi": "3.1.1",
  "info": {
    "title": "Ember Nexus API",
    "version": "0.1.31"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ElementId": {
        "type": "string",
        "format": "uuid",
        "example": "00000000-0000-0000-0000-000000000000",
        "description": "Global unique identifier for any element"
      },
      "Element": {
        "type": "object",
        "required": [
          "type",
          "id",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "Data"
          },
          "id": {
            "$ref": "#/components/schemas/ElementId"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "created": "2025-09-27T10:39:51+00:00",
              "updated": "2025-09-27T10:39:51+00:00",
              "name": "some name"
            }
          },
          "file": {
            "type": "object",
            "additionalProperties": true,
            "readOnly": true,
            "example": {
              "contentLength": 63933,
              "extension": "jpg",
              "mimeType": "image/jpeg"
            }
          },
          "start": {
            "$ref": "#/components/schemas/ElementId",
            "description": "UUID of the start node. Required if end is present."
          },
          "end": {
            "$ref": "#/components/schemas/ElementId",
            "description": "UUID of the end node. Required if start is present."
          }
        }
      },
      "Problem": {
        "$schema": "https://spec.openapis.org/oas/3.0/schema/2021-09-28#/definitions/Schema",
        "type": "object",
        "description": "RFC 7807 Problem Details object.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "NotFoundProblemExample": {
        "summary": "Not found",
        "value": {
          "type": "http://api/error/404/not-found",
          "title": "Not Found",
          "status": 404,
          "detail": "Requested element was not found."
        }
      }
    },
    "parameters": {
      "If-Match": {
        "name": "If-Match",
        "in": "header",
        "required": false,
        "example": "\"YgbFC4u5EgC\"",
        "description": "Used primarily for optimistic concurrency control — the request is only executed if the resource's `ETag` matches the provided value.",
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/If-Match",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/if-match",
            "name": "HTTP.dev"
          }
        ],
        "schema": {
          "type": "string"
        }
      },
      "If-None-Match": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "example": "\"YgbFC4u5EgC\"",
        "description": "Used primarily for caching — skips re-downloading an unchanged resource by returning `304 Not Modified` if the resource's `ETag` matches the provided value.",
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/If-None-Match",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/if-none-match",
            "name": "HTTP.dev"
          }
        ],
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "Access-Control-Allow-Headers": {
        "description": "Specifies which HTTP headers can be used during a cross-origin request, returned in preflight responses.",
        "schema": {
          "type": "string",
          "example": "Authorization, Origin, X-Requested-With, Content-Type, Accept, Access-Control-Request-Method"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Headers",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/access-control-allow-headers",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "Access-Control-Allow-Methods": {
        "description": "Indicates which HTTP methods are permitted for cross-origin requests, typically returned in preflight responses.",
        "schema": {
          "type": "string",
          "example": "GET, HEAD, POST, OPTIONS, PUT, PATCH, DELETE, PROPFIND, PROPPATCH, MKCOL, COPY, MOVE, LOCK, UNLOCK"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Methods",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/access-control-allow-methods",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "Access-Control-Allow-Origin": {
        "description": "Specifies which origin(s) may access the resource.",
        "schema": {
          "type": "string",
          "example": "*"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/access-control-allow-origin",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "Access-Control-Expose-Headers": {
        "description": "Lists the response headers that browsers are allowed to access from JavaScript beyond the default restricted set.",
        "schema": {
          "type": "string",
          "example": "ETag, Location"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Expose-Headers",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/access-control-expose-headers",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "Allow": {
        "description": "Lists the HTTP methods supported by the endpoint; returned alongside a `405 Method Not Allowed` response.",
        "schema": {
          "type": "string",
          "example": "GET, HEAD, POST, OPTIONS, PUT, PATCH, DELETE, PROPFIND, PROPPATCH, MKCOL, COPY, MOVE, LOCK, UNLOCK"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Allow",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/allow",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "Cache-Control": {
        "description": "Directives controlling caching behavior for the response.",
        "schema": {
          "type": "string",
          "example": "no-cache, private"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Cache-Control",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/cache-control",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      },
      "ETag": {
        "description": "Entity tag used for caching and optimistic concurrency control.",
        "schema": {
          "type": "string",
          "example": "\"YgbFC4u5EgC\""
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/ETag",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/etag",
            "name": "HTTP.dev"
          }
        ],
        "x-ember-nexus-important": true,
        "required": true
      },
      "ETag-optional": {
        "description": "Entity tag used for caching and optimistic concurrency control.",
        "schema": {
          "type": "string",
          "example": "\"YgbFC4u5EgC\""
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/ETag",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/etag",
            "name": "HTTP.dev"
          }
        ],
        "x-ember-nexus-important": true,
        "required": false
      },
      "X-Powered-By": {
        "description": "Identifies the underlying API implementation.",
        "schema": {
          "type": "string",
          "example": "Ember Nexus API"
        },
        "x-ember-nexus-links": [
          {
            "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/X-Powered-By",
            "name": "MDN"
          },
          {
            "url": "https://http.dev/x-powered-by",
            "name": "HTTP.dev"
          }
        ],
        "required": true
      }
    }
  },
  "paths": {
    "/{uuid}": {
      "get": {
        "summary": "Get Element",
        "description": "Retrieves a single element (node or relationship) by UUID.",
        "operationId": "getElement",
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/If-Match"
          },
          {
            "$ref": "#/components/parameters/If-None-Match"
          }
        ],
        "responses": {
          "200": {
            "description": "Element found. Returns either a node or a relationship.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Element"
                },
                "examples": {
                  "node": {
                    "summary": "Node response",
                    "value": {
                      "type": "Comment",
                      "id": "74a8fcd9-6cb0-4b0d-8d42-0b6c3c54d1ac",
                      "data": {
                        "created": "2025-09-27T10:39:51+00:00",
                        "updated": "2025-09-27T10:39:51+00:00",
                        "name": "Blue",
                        "content": "Blue is one of the three primary colours in the RYB colour model...\n"
                      }
                    }
                  },
                  "relationship": {
                    "summary": "Relationship response",
                    "value": {
                      "type": "OWNS",
                      "id": "eb5d2879-c5e6-43a6-b8ce-2a1188ca7073",
                      "start": "56fda20c-b238-4034-b555-1df47c47e17a",
                      "end": "ce8abdea-2e6c-41d4-b779-87b803f77836",
                      "data": {
                        "created": "2025-09-27T10:39:58+00:00",
                        "updated": "2025-09-27T10:39:58+00:00"
                      }
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not modified. Returned when If-None-Match header matches current ETag.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            }
          },
          "401": {
            "description": "Unauthorized. Invalid or expired token.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Element not found, or user lacks access.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "notFound": {
                    "$ref": "#/components/examples/NotFoundProblemExample"
                  }
                }
              }
            }
          },
          "412": {
            "description": "Precondition failed. If-Match or If-None-Match condition not met.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Rate limit exceeded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Element"
        ]
      }
    }
  }
}
