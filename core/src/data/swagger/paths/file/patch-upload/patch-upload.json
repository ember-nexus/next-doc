{
  "paths": {
    "/upload/{uuid}": {
      "patch": {
        "summary": "Patch upload",
        "description": "Appends the next chunk to a resumable upload. Set `Upload-Complete: ?1` on the chunk that finishes the upload - the request body may be empty, which both completes an upload without transmitting further data and behaves like `HEAD /upload/<uuid>` otherwise.",
        "operationId": "patch-upload",
        "tags": [
          "File"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Id of the resumable upload, as returned in the `Location` header of the request that created it."
          },
          {
            "name": "Upload-Offset",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 5242880
            },
            "description": "Byte offset the appended chunk starts at. Must match the upload's current `Upload-Offset` exactly, otherwise the request fails with `409 Conflict`."
          },
          {
            "name": "Upload-Complete",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "?0"
            },
            "description": "`?1` marks this as the final chunk, completing the upload; omitted or `?0` keeps the upload open for further chunks."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/partial-upload": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "x-ember-nexus-har-example": {
          "method": "PATCH",
          "url": "https://api.example.com/upload/7b80b203-2b82-40f5-accd-c7089fe6114e",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer secret-token:PIPeJGUt7c00ENn8a5uDlc"
            },
            {
              "name": "Content-Type",
              "value": "application/partial-upload"
            },
            {
              "name": "Upload-Offset",
              "value": "5242880"
            },
            {
              "name": "Upload-Complete",
              "value": "?1"
            }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": -1,
          "postData": {
            "mimeType": "application/partial-upload",
            "text": "<binary chunk data>"
          }
        }
      }
    }
  }
}
