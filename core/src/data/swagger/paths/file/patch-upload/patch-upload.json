{
  "paths": {
    "/upload/{uuid}": {
      "patch": {
        "summary": "Patch upload",
        "description": "Appends data to a resumable upload instance.",
        "operationId": "patch-upload",
        "tags": [
          "File"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Id of the element whose data is to be updated."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Arbitrary data related to the element.",
                "additionalProperties": true,
                "example": {
                  "hello": "world :D"
                }
              }
            }
          }
        },
        "x-ember-nexus-har-example": {
          "method": "PATCH",
          "url": "https://api.example.com/upload/7b80b203-2b82-40f5-accd-c7089fe6114e",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            {
              "name": "Authorization",
              "value": "Bearer secret-token:PIPeJGUt7c00ENn8a5uDlc"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": -1,
          "postData": {
            "mimeType": "application/json",
            "text": "{\"someDataKey\": \"some new value :D\"}"
          }
        }
      }
    }
  }
}
