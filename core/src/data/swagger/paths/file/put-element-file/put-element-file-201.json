{
  "paths": {
    "/{uuid}/file": {
      "put": {
        "responses": {
          "201": {
            "description": "`PUT` element file request was successful. Specific meaning depends on request:\n\n- When a complete file was uploaded: The file was successfully replaced.\n- When a resumable file upload was requested: The resumable file upload was created successfully, see `Location`-header for its URL.",
            "headers": {
              "Access-Control-Allow-Headers": {
                "$ref": "#/components/headers/Access-Control-Allow-Headers"
              },
              "Access-Control-Allow-Methods": {
                "$ref": "#/components/headers/Access-Control-Allow-Methods"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/Access-Control-Allow-Origin"
              },
              "Access-Control-Expose-Headers": {
                "$ref": "#/components/headers/Access-Control-Expose-Headers"
              },
              "Allow": {
                "$ref": "#/components/headers/Allow"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/Cache-Control"
              },
              "Location": {
                "$ref": "#/components/headers/Location-created"
              },
              "X-Powered-By": {
                "$ref": "#/components/headers/X-Powered-By"
              }
            },
            "x-ember-nexus-links": [
              {
                "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/204",
                "name": "MDN"
              },
              {
                "url": "https://http.dev/204",
                "name": "HTTP.dev"
              }
            ]
          }
        }
      }
    }
  }
}
