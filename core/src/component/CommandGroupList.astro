---
import { getCollection } from 'astro:content';
import { commandPath } from '../lib/routes';

interface Props {
    /**
     * The command group / namespace to filter on.
     * Matches the prefix before the first colon in the `command` frontmatter,
     * e.g. "backup", "cache", "user".
     * Commands without a colon (e.g. "healthcheck") belong to group "system".
     */
    group: string;
}

const { group } = Astro.props;

const entries = (await getCollection('commands'))
    .filter((e) => {
        const cmd = e.data.command;
        const colonIdx = cmd.indexOf(':');
        const namespace = colonIdx === -1 ? 'system' : cmd.slice(0, colonIdx);
        return namespace === group;
    })
    .sort((a, b) => a.data.command.localeCompare(b.data.command));
---
<ul class="not-prose cgl-list">
    {entries.map((e) => (
        <li>
            <a href={commandPath(e.data.command)} class="cgl-link">
                <code class="cgl-command">php bin/console {e.data.command}</code>
            </a>
        </li>
    ))}
</ul>

<style>
    .cgl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .cgl-list li {
        margin: 0;
        padding: 0;
    }

    .cgl-link {
        display: block;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-hairline, #e4e4e7);
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }

    .cgl-link:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .cgl-link:focus-visible {
        outline: 2px solid var(--color-amber-500);
        outline-offset: 2px;
    }

    .cgl-command {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-neutral-700, #3f3f46);
        background: none;
        padding: 0;
        border: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    @media (prefers-color-scheme: dark) {
        .cgl-link {
            border-color: var(--color-hairline, #3f3f46);
        }

        .cgl-link:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .cgl-command {
            color: var(--color-neutral-300, #d4d4d8);
        }
    }
</style>
