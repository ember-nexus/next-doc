---
import SwaggerParser from '@apidevtools/swagger-parser';
import type { OpenAPIObject } from 'openapi3-ts/oas31';

import { extractSchemas } from '../util';
const spec = (await SwaggerParser.parse('./src/data/swagger.json')) as OpenAPIObject;
const schemas = extractSchemas(spec).sort((a, b) => a.name.localeCompare(b.name));
---
<ul class="not-prose sl-list">
    {schemas.map((s) => (
        <li>
            <a href={`/schema/${s.id}`} class="sl-link">
                <code class="sl-name">{s.name}</code>
            </a>
        </li>
    ))}
</ul>

<style>
    .sl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .sl-list li {
        margin: 0;
        padding: 0;
    }

    .sl-link {
        display: block;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-hairline, #e4e4e7);
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }

    .sl-link:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .sl-link:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
    }

    .sl-name {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-neutral-700, #3f3f46);
        background: none;
        padding: 0;
        border: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    @media (prefers-color-scheme: dark) {
        .sl-link {
            border-color: var(--color-hairline, #3f3f46);
        }

        .sl-link:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }

        .sl-name {
            color: var(--color-neutral-300, #d4d4d8);
        }
    }
</style>
