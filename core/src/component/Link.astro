---
import { Icon } from 'astro-icon/components';

import type { Link } from "../type";
import { isExternalHref } from "../plugins/rehype/linkAugmentation";

interface Props {
    link: Link;
}

const { link } = Astro.props;

const isExternal = isExternalHref(link.url);
const icon = isExternal ? "arrow-up-right" : "arrow-right";
---
<a
    href={link.url}
    class="text-sm text-blue-700 hover:underline"
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
>
    {link.name}&hairsp;<Icon name={icon} class="size-4 inline-block" style="vertical-align: calc(50% - 14px)" />
</a>