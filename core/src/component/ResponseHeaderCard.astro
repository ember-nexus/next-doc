---
import { marked } from 'marked';
import { Icon } from 'astro-icon/components';
import type { ResponseHeader } from "../type";
import Link from "./Link.astro";
import CardTitle from "./CardTitle.astro";

interface Props {
    headers: ResponseHeader[];
}

const { headers } = Astro.props;

const important = headers.filter(h => h.important);
const others = headers.filter(h => !h.important);
---
<div class="response-header-card">
    <CardTitle title="Response Header">
        <span slot="meta" class="text-sm text-gray-400">
            {important.length} relevant · {others.length} others
        </span>
    </CardTitle>
    <div class="bg-white dark:bg-black border border-hairline rounded-xl shadow-xs">
        <div class="divide-y divide-hairline">
            {important.map((header) => (
                <div class="flex flex-col gap-2 px-4 py-3">
                    <div class="flex items-center justify-between mb-1">
                        <p class="font-mono text-sm font-medium">{header.header}</p>
                        <p class="text-xs font-semibold tracking-wider uppercase text-gray-400">
                            {header.presence}
                        </p>
                    </div>
                    <div class="text-sm text-gray-600 dark:text-gray-400" set:html={marked.parse(header.description)}></div>
                    <div class="flex gap-4">
                        {header.links.map((link) => <Link link={link} />)}
                    </div>
                </div>
            ))}
        </div>
        {others.length > 0 && (
            <div x-data="{ open: false }">
                <div class="flex items-center gap-3 py-2">
                    <div class="flex-1 h-px bg-hairline"></div>
                    <button
                        @click="open = !open"
                        class="flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer whitespace-nowrap"
                    >
                        Other Headers
                        <Icon name="chevron-down" class="size-4 transition-transform" :class="{ 'rotate-180': open }" />
                    </button>
                    <div class="flex-1 h-px bg-hairline"></div>
                </div>
                <div x-show="open" class="divide-y divide-hairline">
                    {others.map((header) => (
                        <div class="flex flex-col gap-2 px-4 py-3">
                            <div class="flex items-center justify-between mb-1">
                                <p class="font-mono text-sm font-medium">{header.header}</p>
                                <p class="text-xs font-semibold tracking-wider uppercase text-gray-400">
                                    {header.presence}
                                </p>
                            </div>
                            <div class="text-sm text-gray-600 dark:text-gray-400" set:html={marked.parse(header.description)}></div>
                            <div class="flex gap-4">
                                {header.links.map((link) => <Link link={link} />)}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        )}
    </div>
</div>