---
import { marked } from 'marked';
import { Icon } from 'astro-icon/components';
import type { ResponseHeader } from "../type";
import Link from "./Link.astro";

interface Props {
    headers: ResponseHeader[];
}

const { headers } = Astro.props;

const important = headers.filter(h => h.important);
const others = headers.filter(h => !h.important);
---

<div class="request-header-card bg-white dark:bg-black border border-gray-200 dark:border-gray-800 rounded-xl shadow-xs">

    <div class="flex items-baseline justify-between px-4 pt-4 pb-3">
        <h1 class="text-lg font-semibold">Response headers</h1>
        <span class="text-sm text-gray-400">
            {important.length} relevant · {others.length} others
        </span>
    </div>

    {important.map((header) => (
        <div class="flex flex-col gap-2 border-t border-gray-200 dark:border-gray-800 px-4 py-3">
            <div class="flex items-center justify-between mb-1">
                <p class="font-mono text-sm font-medium">{header.header}</p>
                <p class={`text-xs font-semibold tracking-wider uppercase text-gray-400`}>
                    {header.presence}
                </p>
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400" set:html={marked.parse(header.description)}></div>
            <div class="flex gap-4">
                {header.links.map((link) => <Link link={link} />)}
            </div>
        </div>
    ))}
    {others.length > 0 && (
        <div x-data="{ open: false }">
            <div class="flex items-center gap-3 py-2">
                <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800"></div>
                <button
                    @click="open = !open"
                    class="flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer"
                >
                    OTHER HEADERS ({others.length})
                    <Icon name="chevron-down" class="size-4" :class="{ 'rotate-180': open }" />
                </button>
                <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800"></div>
            </div>
            <div x-show="open">
                {others.map((header, i) => (
                    <div class={`flex flex-col gap-2 px-4 py-3 ${i > 0 ? 'border-t border-gray-200 dark:border-gray-800' : ''}`}>
                        <div class="flex items-center justify-between mb-1">
                            <p class="font-mono text-sm font-medium">{header.header}</p>
                            <p class={`text-xs font-semibold tracking-wider uppercase text-gray-400`}>
                                {header.presence}
                            </p>
                        </div>
                        <div class="text-sm text-gray-600 dark:text-gray-400" set:html={marked.parse(header.description)}></div>
                        <div class="flex gap-4">
                            {header.links.map((link) => <Link link={link} />)}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    )}
</div>