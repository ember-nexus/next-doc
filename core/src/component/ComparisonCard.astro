---
import { Icon } from 'astro-icon/components';

interface Props {
    variant: "good" | "bad";
    title: string;
}

const { variant, title } = Astro.props;

const icons: Record<Props["variant"], string> = {
    good: "check",
    bad: "x",
};

const styles: Record<Props["variant"], { border: string; bg: string; text: string }> = {
    good: {
        border: "border-green-500 dark:border-green-700",
        bg: "bg-green-50 dark:bg-green-950",
        text: "text-green-800 dark:text-green-300",
    },
    bad: {
        border: "border-red-500 dark:border-red-700",
        bg: "bg-red-50 dark:bg-red-950",
        text: "text-red-800 dark:text-red-200",
    },
};

const icon = icons[variant];
const style = styles[variant];
---

<div class={`comparison-card rounded-lg border ${style.border} overflow-hidden`}>
    <header class={`px-4 py-2 font-medium ${style.bg} ${style.text}`}>
        <Icon
            name={icon}
            class="inline-block size-4 align-text-bottom mr-1.5"
        /><span>{title}</span>
    </header>
    <div>
        <slot />
    </div>
</div>