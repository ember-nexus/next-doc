---
import type {SidebarEndpointItemDto} from "../type";

interface Props {
    sidebarItem: SidebarEndpointItemDto;
    active: boolean;
}

const {sidebarItem, active} = Astro.props;
const method = sidebarItem?.method?.toLowerCase() ?? '-';
---

{sidebarItem && (
    <li>
        <a
            href={sidebarItem.url}
            aria-current={active ? "page" : undefined}
            style={`--c: var(--method-${method}, var(--method-put))`}
            class="block rounded-md px-3 py-1.5 text-[0.8125rem] no-underline text-zinc-900 dark:text-zinc-100 hover:bg-black/5 dark:hover:bg-white/[0.06] aria-[current]:bg-black/[0.06] dark:aria-[current]:bg-white/[0.09]"
        >
            <p class="m-0 font-mono">
                <b class="font-semibold text-[var(--c)] uppercase">{sidebarItem.method}</b>
                {" "}{sidebarItem.endpointUrl}
            </p>
            <p class="mb-0 font-mono text-zinc-900 dark:text-zinc-100">{sidebarItem.name}</p>
        </a>
    </li>
)}