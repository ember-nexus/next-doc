---
import {
    type HttpStatusCode,
    getHttpStatusCodeFamily,
} from "../../type";

interface Props {
    httpStatusCode: HttpStatusCode;
    name: string | null;
    targetPanelId: string;
    isInitiallyActive: boolean;
}

const { httpStatusCode, name, targetPanelId, isInitiallyActive } = Astro.props;

const family = getHttpStatusCodeFamily(httpStatusCode);
const variant = family >= 4 ? "error" : family === 3 ? "redirect" : "success";
---

<button
        type="button"
        role="tab"
        aria-selected={isInitiallyActive ? "true" : "false"}
        aria-controls={targetPanelId}
        tabindex={isInitiallyActive ? 0 : -1}
        data-status-code-tab
        data-variant={variant}
        data-target={targetPanelId}
        class:list={[
            "rounded-full px-3.5 py-1 text-[0.875em] font-medium leading-none",
            "border transition-colors cursor-pointer",
            "focus-visible:outline-2 focus-visible:outline-offset-2",
            "focus-visible:outline-[var(--http-status-code-focus-ring)]",
            "border-[var(--http-status-code-border)]",
            "text-[var(--http-status-code-fg)]",
            "bg-[var(--http-status-code-bg)]",
            "hover:bg-[var(--http-status-code-bg-hover)]",
            "aria-selected:bg-[var(--http-status-code-bg-active)]",
            "aria-selected:text-[var(--http-status-code-fg-active)]",
            "aria-selected:border-[var(--http-status-code-bg-active)]",
        ]}
>
    <span class="font-semibold">{httpStatusCode}</span>
    {name && (
            <span class="ml-1.5 opacity-90">{name}</span>
    )}
</button>