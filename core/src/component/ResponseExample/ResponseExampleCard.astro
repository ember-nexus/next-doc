---
import type { ResponseExample } from "../../type";
import StatusCodeTab from "./StatusCodeTab.astro";
import ResponseExamplePanel from "./ResponseExamplePanel.astro";

interface Props {
    examples: ResponseExample[];
    groupId?: string;
}

const { examples, groupId = "example-responses" } = Astro.props;

const buildTabId = (index: number) => `${groupId}-tab-${index}`;
const buildPanelId = (index: number) => `${groupId}-panel-${index}`;
---

<section
        aria-labelledby={`${groupId}-heading`}
        class="not-prose"
        data-status-code-group
>
    <h2
            id={`${groupId}-heading`}
            class="mb-3 text-[0.85em] font-semibold uppercase tracking-wider
               text-[var(--surface-fg-muted)]"
    >
        Example Responses
    </h2>

    <div
            class="rounded-xl border border-[var(--surface-border)]
               bg-[var(--surface-bg)] overflow-hidden"
    >
        <div
                role="tablist"
                aria-label="Status code examples"
                class="flex flex-wrap gap-2 p-4 border-b border-[var(--surface-border)]"
        >
            {examples.map((example, index) => (
                    <StatusCodeTab
                            httpStatusCode={example.httpStatusCode}
                            name={example.name}
                            targetPanelId={buildPanelId(index)}
                            isInitiallyActive={index === 0}
                    />
            ))}
        </div>

        {examples.map((example, index) => (
                <ResponseExamplePanel
                        example={example}
                        panelId={buildPanelId(index)}
                        parentTabId={buildTabId(index)}
                        isInitiallyActive={index === 0}
                />
        ))}
    </div>
</section>

<script>
    const initStatusCodeTabs = (group: HTMLElement) => {
        const statusTabs = Array.from(
            group.querySelectorAll<HTMLButtonElement>("[data-status-code-tab]")
        );
        const statusPanels = Array.from(
            group.querySelectorAll<HTMLElement>("[data-status-code-panel]")
        );

        const activateStatusTab = (targetTab: HTMLButtonElement) => {
            const targetId = targetTab.dataset.target;
            statusTabs.forEach((tab) => {
                const isActive = tab === targetTab;
                tab.setAttribute("aria-selected", String(isActive));
                tab.setAttribute("tabindex", isActive ? "0" : "-1");
            });
            statusPanels.forEach((panel) => {
                panel.hidden = panel.id !== targetId;
            });
        };

        const handleStatusTabKeydown = (event: KeyboardEvent) => {
            const currentIndex = statusTabs.indexOf(
                event.target as HTMLButtonElement
            );
            if (currentIndex === -1) return;

            let nextIndex = currentIndex;
            if (event.key === "ArrowRight") {
                nextIndex = (currentIndex + 1) % statusTabs.length;
            } else if (event.key === "ArrowLeft") {
                nextIndex =
                    (currentIndex - 1 + statusTabs.length) % statusTabs.length;
            } else if (event.key === "Home") {
                nextIndex = 0;
            } else if (event.key === "End") {
                nextIndex = statusTabs.length - 1;
            } else {
                return;
            }
            event.preventDefault();
            const nextTab = statusTabs[nextIndex];
            activateStatusTab(nextTab);
            nextTab.focus();
        };

        statusTabs.forEach((tab) => {
            tab.addEventListener("click", () => activateStatusTab(tab));
            tab.addEventListener("keydown", handleStatusTabKeydown);
        });

        statusPanels.forEach((panel) => initContentTabs(panel));
    };

    const initContentTabs = (panel: HTMLElement) => {
        const contentTabs = Array.from(
            panel.querySelectorAll<HTMLButtonElement>("[data-content-tab]")
        );
        const contentPanels = Array.from(
            panel.querySelectorAll<HTMLElement>("[data-content-panel]")
        );

        const activateContentTab = (targetTab: HTMLButtonElement) => {
            const targetId = targetTab.dataset.target;
            contentTabs.forEach((tab) => {
                const isActive = tab === targetTab;
                tab.setAttribute("aria-selected", String(isActive));
                tab.setAttribute("tabindex", isActive ? "0" : "-1");
            });
            contentPanels.forEach((contentPanel) => {
                contentPanel.hidden = contentPanel.id !== targetId;
            });
        };

        const handleContentTabKeydown = (event: KeyboardEvent) => {
            const currentIndex = contentTabs.indexOf(
                event.target as HTMLButtonElement
            );
            if (currentIndex === -1) return;

            let nextIndex = currentIndex;
            if (event.key === "ArrowRight") {
                nextIndex = (currentIndex + 1) % contentTabs.length;
            } else if (event.key === "ArrowLeft") {
                nextIndex =
                    (currentIndex - 1 + contentTabs.length) %
                    contentTabs.length;
            } else {
                return;
            }
            event.preventDefault();
            const nextTab = contentTabs[nextIndex];
            activateContentTab(nextTab);
            nextTab.focus();
        };

        contentTabs.forEach((tab) => {
            tab.addEventListener("click", () => activateContentTab(tab));
            tab.addEventListener("keydown", handleContentTabKeydown);
        });
    };

    document
        .querySelectorAll<HTMLElement>("[data-status-code-group]")
        .forEach(initStatusCodeTabs);
</script>