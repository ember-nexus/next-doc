---
import { Code } from 'astro-expressive-code/components';
import CardTitle from "./CardTitle.astro";

interface Props {
    responseBody: object;
    responseHeaders: string;
    graphLayout?: string;
}

const { responseBody, responseHeaders, graphLayout = "grid" } = Astro.props;

const body = responseBody as any;
const debugSteps = Array.isArray(body?.debug) ? body.debug : [];
const lastDebugStep = debugSteps[debugSteps.length - 1];
const hasGraph = lastDebugStep?.input?.type === "element-hydration";

const tabLabels: Record<string, string> = {
    'graph':      'Graph',
    'table':      'Table',
    'debug':      'Debug',
    'body-raw':   'Raw Body',
    'header-raw': 'Raw Headers',
};

const tabs = [...(hasGraph ? ['graph'] : []), 'table', 'debug', 'body-raw', 'header-raw'];
const firstTab = tabs[0];

const prettyBody = JSON.stringify(responseBody, null, 2);
const prettyDebug = JSON.stringify(body?.debug ?? {}, null, 2);
const graphElements = JSON.stringify({ elements: body?.results ?? [] });
---

<div class="search-response-card">
    <CardTitle title="Search response" />

    <div
        x-data={`{ tab: '${firstTab}' }`}
        class="bg-white dark:bg-black block border border-hairline rounded-xl shadow-xs flex flex-col divide-y divide-gray-200 dark:divide-gray-800"
    >
        <!-- Tab bar -->
        <div class="flex border-b border-gray-200 dark:border-gray-800 px-4">
            {tabs.map((t) => {
                const label = tabLabels[t] ?? t;
                return (
                    <button
                        @click={`tab = '${t}'`}
                        :class={`tab === '${t}' ? 'font-semibold border-b-2 border-current' : ''`}
                        class="px-3 py-2 text-sm cursor-pointer before:block before:h-0 before:invisible before:font-semibold"
                        data-label={label}
                        style={`--tab-label: '${label}'`}
                    >
                        {label}
                    </button>
                );
            })}
        </div>

        <!-- Tab panels -->
        <div class="relative">
            {/* Graph: always mounted, hidden via visibility to prevent G6 re-init & resize flash */}
            {hasGraph && (
                <div
                    :class={`tab === 'graph' ? '' : 'invisible absolute inset-0 pointer-events-none overflow-hidden'`}
                    class="p-4 min-h-[250px]"
                >
                    <g6-graph layout={graphLayout}>
                        <script type="application/json" set:html={graphElements} />
                    </g6-graph>
                </div>
            )}

            <div x-show="tab === 'table'" x-cloak class="p-4 min-h-[250px]">
                <p class="text-sm text-gray-500">Table view coming soon.</p>
            </div>

            <div x-show="tab === 'debug'" x-cloak>
                <Code code={prettyDebug} lang="json" class="not-prose rounded-b-xl text-[0.875rem]" />
            </div>

            <div x-show="tab === 'body-raw'" x-cloak>
                <Code code={prettyBody} lang="json" class="not-prose rounded-b-xl text-[0.875rem]" />
            </div>

            <div x-show="tab === 'header-raw'" x-cloak>
                <Code code={responseHeaders} lang="http" class="not-prose rounded-b-xl text-[0.875rem]" />
            </div>
        </div>
    </div>
</div>