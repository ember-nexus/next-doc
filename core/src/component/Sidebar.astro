---
import { Icon } from 'astro-icon/components';
import { buildSidebar } from '../lib';
import SidebarNode from './SidebarNode.astro';

const items = await buildSidebar();
const currentPath = Astro.url.pathname;
---
<aside
    id="primary-sidebar"
    class="fixed inset-y-0 left-0 z-40 flex h-dvh w-full flex-col border-r border-gray-200 bg-white transition-transform duration-200 ease-in-out max-sm:-translate-x-full dark:border-gray-800 dark:bg-gray-950 sm:w-64 print:hidden"
    :class="{ '!translate-x-0': sidebarOpen === true, '!-translate-x-full': sidebarOpen === false }"
    x-init="
    $nextTick(() => requestAnimationFrame(() => {
      $el.querySelector('[aria-current=page]')?.scrollIntoView({ block: 'center', behavior: 'instant' })
    }))
  "
    x-effect="
    if (sidebarOpen) $nextTick(() => requestAnimationFrame(() => {
      $el.querySelector('[aria-current=page]')?.scrollIntoView({ block: 'center', behavior: 'instant' })
    }))
  "
>
    <button
        type="button"
        @click="sidebarOpen = false"
        aria-label="Close sidebar"
        class="absolute right-4 top-4 z-50 inline-flex items-center justify-center rounded-md p-2 text-gray-700 transition hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 dark:text-gray-200 dark:hover:bg-gray-800 sm:hidden"
    >
        <Icon name="x" class="size-4" />
    </button>
    <nav class="flex-1 overflow-y-auto overscroll-contain p-4">
        <ul>
            {items.map((item) => <SidebarNode item={item} currentPath={currentPath} />)}
        </ul>
    </nav>
</aside>
