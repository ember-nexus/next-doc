---
import { Icon } from 'astro-icon/components';

interface Props {
    /** Unique id for this panel — used for the overlay-open event and HTML id */
    id: string;
    /** Which edge the panel slides in from */
    side?: 'left' | 'right';
    /** aria-label for the <aside> */
    label?: string;
    /**
     * Extra classes applied only on sm: and above.
     * Use this to thread desktop-only styles (e.g. permanent sidebar widths/borders)
     * into a panel that is also an overlay on mobile.
     */
    desktopClass?: string;
}

const {
    id,
    side = 'right',
    label,
    desktopClass = '',
} = Astro.props;

const hasTitle = Astro.slots.has('title');

// Translate classes based on side
const startPos = side === 'right' ? 'translate-x-full'  : '-translate-x-full';
const anchorX  = side === 'right' ? 'right-0'           : 'left-0';

const closeBtn = "shrink-0 inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 transition hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 dark:text-gray-200 dark:hover:bg-gray-800";
---

<aside
    id={id}
    data-overlay-panel={id}
    data-overlay-side={side}
    class:list={[
        "fixed bottom-0 top-14 z-40 flex h-[calc(100dvh-3.5rem)] w-full flex-col bg-white",
        "transition-transform duration-200 ease-in-out",
        "dark:bg-gray-950 print:hidden",
        anchorX,
        startPos,
        desktopClass,
    ]}
    aria-label={label}
>
    {hasTitle ? (
        /* ── Title slot: header row with title content + X button, body below ── */
        <>
            <div class="flex shrink-0 items-center gap-2 border-b border-gray-200 px-3 py-2 dark:border-gray-800">
                <div class="min-w-0 flex-1">
                    <slot name="title" />
                </div>
                <button
                    type="button"
                    data-overlay-close={id}
                    aria-label="Close"
                    class={closeBtn}
                >
                    <Icon name="x" class="size-4" />
                </button>
            </div>
            <div class="flex-1 overflow-y-auto overscroll-contain p-4">
                <slot />
            </div>
        </>
    ) : (
        /* ── Default: X button floats absolute, content fills ── */
        <>
            <button
                type="button"
                data-overlay-close={id}
                aria-label="Close"
                class:list={[
                    "absolute top-4 z-50",
                    closeBtn,
                    'right-4',
                ]}
            >
                <Icon name="x" class="size-4" />
            </button>
            <div class="flex-1 overflow-y-auto overscroll-contain p-4">
                <slot />
            </div>
        </>
    )}
</aside>

<script>
    // Track which panel ids have already had their window listeners registered,
    // so re-initialisation on astro:page-load doesn't pile up duplicate listeners.
    const _registeredPanels = new Set<string>();

    function initOverlayPanel(panel: HTMLElement) {
        const panelId    = panel.dataset.overlayPanel!;
        const side       = (panel.dataset.overlaySide ?? 'right') as 'left' | 'right';
        const openClass  = '!translate-x-0';
        const closeClass = side === 'right' ? '!translate-x-full' : '!-translate-x-full';

        // Close buttons live inside the panel DOM — re-attach on every init
        // (safe: new DOM nodes after page-load navigation).
        panel.querySelectorAll<HTMLElement>(`[data-overlay-close="${panelId}"]`).forEach(btn => {
            btn.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('overlay-close', { detail: { id: panelId } }));
            });
        });

        // Window listeners are permanent — only register once per panel id.
        if (_registeredPanels.has(panelId)) return;
        _registeredPanels.add(panelId);

        window.addEventListener('overlay-open', (e: Event) => {
            const el = document.querySelector<HTMLElement>(`[data-overlay-panel="${panelId}"]`);
            if (!el) return;
            const { id } = (e as CustomEvent<{ id: string }>).detail;
            if (id === panelId) {
                el.classList.remove(closeClass);
                el.classList.add(openClass);
            } else {
                el.classList.remove(openClass);
                el.classList.add(closeClass);
            }
        });

        window.addEventListener('overlay-close', (e: Event) => {
            const el = document.querySelector<HTMLElement>(`[data-overlay-panel="${panelId}"]`);
            if (!el) return;
            const { id } = (e as CustomEvent<{ id: string }>).detail;
            if (id === panelId) {
                el.classList.remove(openClass);
                el.classList.add(closeClass);
            }
        });

        window.addEventListener('overlay-toggle', (e: Event) => {
            const el = document.querySelector<HTMLElement>(`[data-overlay-panel="${panelId}"]`);
            if (!el) return;
            const { id } = (e as CustomEvent<{ id: string }>).detail;
            if (id !== panelId) return;
            const isOpen = el.classList.contains(openClass);
            window.dispatchEvent(new CustomEvent(
                isOpen ? 'overlay-close' : 'overlay-open',
                { detail: { id: panelId } }
            ));
        });
    }

    function init() {
        document.querySelectorAll<HTMLElement>('[data-overlay-panel]').forEach(initOverlayPanel);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    document.addEventListener('astro:page-load', init);
</script>
