---
import { getCollection } from 'astro:content';
import { endpointPath } from '../lib/routes';

interface Props {
    /** The `group` frontmatter value to filter on, e.g. "element" or "file-and-upload". */
    group: string;
}

const { group } = Astro.props;

const entries = (await getCollection('endpoints'))
    .filter((e) => e.data.group === group)
    .sort((a, b) => a.id.localeCompare(b.id));
---
<ul class="not-prose egl-list">
    {entries.map((e) => (
        <li>
            <a
                href={endpointPath(e.data.endpoint)}
                style={`--c: var(--method-${e.data.method.toLowerCase()}, var(--method-put))`}
                class="egl-link"
            >
                <p class="egl-url">
                    <b class="egl-method">{e.data.method.toUpperCase()}</b>
                    {" "}{e.data.endpointUrl}
                </p>
                <p class="egl-name">{e.data.name}</p>
            </a>
        </li>
    ))}
</ul>

<style>
    .egl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .egl-list li {
        margin: 0;
        padding: 0;
    }

    .egl-link {
        display: block;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-hairline, #e4e4e7);
        text-decoration: none;
        color: #111827; /* zinc-900 */
        transition: background-color 0.15s ease;
    }

    .egl-link:hover,
    .egl-link:visited {
        color: #111827; /* zinc-900 */
        background-color: rgba(0, 0, 0, 0.05);
    }

    .egl-link:focus-visible {
        outline: 2px solid var(--color-amber-500);
        outline-offset: 2px;
    }

    .egl-url {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .egl-method {
        font-weight: 600;
        color: var(--c);
        text-transform: uppercase;
    }

    .egl-name {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: #111827; /* zinc-900 */
    }

    @media (prefers-color-scheme: dark) {
        .egl-link {
            border-color: var(--color-hairline, #3f3f46);
            color: #f4f4f5; /* zinc-100 */
        }
        .egl-link:hover,
        .egl-link:visited {
            color: #f4f4f5; /* zinc-100 */
            background-color: rgba(255, 255, 255, 0.06);
        }
    }
</style>
