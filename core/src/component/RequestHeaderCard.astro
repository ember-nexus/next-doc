---
import { marked } from 'marked';
import type { RequestHeader } from "../type";
import Link from "./Link.astro";

interface Props {
    headers: RequestHeader[];
}

const { headers } = Astro.props;
---

<div class="request-header-card bg-white dark:bg-black border border-gray-200 dark:border-gray-800 rounded-xl shadow-xs">

    <div class="flex items-baseline justify-between px-4 pt-4 pb-3">
        <h1 class="text-lg font-semibold">Request headers</h1>
        <span class="text-sm text-gray-400">{headers.length} headers</span>
    </div>

    {headers.map((header) => (
        <div class="flex flex-col gap-2 border-t border-gray-200 dark:border-gray-800 px-4 py-3">
            <div class="flex items-center justify-between mb-1">
                <p class="font-mono text-sm font-medium">{header.header}</p>
                <p class={`text-xs font-semibold tracking-wider uppercase ${header.presence === 'required' ? 'text-red-500' : 'text-gray-400'}`}>
                    {header.presence}
                </p>
            </div>
            <div class="text-sm text-gray-600 dark:text-gray-400" set:html={marked.parse(header.description)}></div>
            <div class="flex gap-4">
                {header.links.map((link) => (
                    <Link link={link} />
                ))}
            </div>
        </div>
    ))}

</div>