---
import type { RequestHeader } from "../type";
import CardTitle from "./CardTitle.astro";
import HeaderRow from "./HeaderRow.astro";

interface Props {
    headers: RequestHeader[];
}

const { headers } = Astro.props;
---
<div class="request-header-card">
    <CardTitle title="Request Header"></CardTitle>
    <div class="api-card divide-y divide-hairline">
        {headers.map((header) => (
            <HeaderRow
                name={header.header}
                presence={header.presence}
                description={header.description}
                links={header.links}
                highlightRequired
            />
        ))}
    </div>
</div>
