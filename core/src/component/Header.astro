---
import { Icon } from "astro-icon/components";
import Search from "astro-pagefind/components/Search.astro";
import SidebarToggle from "./SidebarToggle.astro";

let version = import.meta.env.VERSION;
if (!version || version === '') {
    version = 'dev';
}

const iconBtn =
    "inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-gray-700 transition hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 dark:text-gray-200 dark:hover:bg-gray-800";
---

<header
    class="fixed inset-x-0 top-0 z-50 flex h-14 items-center gap-2 border-b border-gray-200 bg-white px-3 sm:h-16 sm:px-4 dark:border-gray-800 dark:bg-gray-900"
>
    <SidebarToggle icon="panel-left" />

    <a
        href="/"
        aria-label="Ember Nexus API — home"
        class="flex items-center gap-2 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400"
    >
        <img src="/logo.svg" alt="" class="size-6 sm:size-7" />
        <span class="hidden text-2xl font-qanelas-soft-custom tracking-tight text-gray-900 sm:inline dark:text-gray-100">
      Ember Nexus API
    </span>
    </a>

    {version && (
        <span class="hidden font-mono text-md text-gray-500 sm:inline dark:text-gray-400">
      {version}
    </span>
    )}

    <div class="ml-auto flex items-center gap-1">
        <div class="w-40 sm:w-60">
            <Search instance="search" className="pagefind-ui" searchboxOptions={{ placeholder: "search" }} />
        </div>

        <a href="https://github.com/ember-nexus/api" target="_blank" rel="noreferrer" aria-label="GitHub" class:list={["hidden sm:inline-flex", iconBtn]}>
            <Icon name="github" class="size-5" />
        </a>
        <a href="https://hub.docker.com/r/embernexus/api" target="_blank" rel="noreferrer" aria-label="Docker Hub" class:list={["hidden sm:inline-flex", iconBtn]}>
            <Icon name="docker" class="size-5" />
        </a>

        <div class="mx-1 h-6 w-px bg-gray-200 dark:bg-gray-800 sm:hidden"></div>

        <button type="button" aria-label="Toggle table of contents" class:list={["sm:hidden", iconBtn]} @click="tocOpen = !tocOpen; if (tocOpen) sidebarOpen = null" :aria-expanded="tocOpen">
            <Icon name="menu" class="size-5" />
        </button>
    </div>
</header>
