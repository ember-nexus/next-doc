---
import {
    getHttpStatusCodeFamily,
    getHttpStatusCodeFamilyLabel,
    getHttpStatusCodeLabel,
    type ResponseExample,
} from "../type";
import { Code } from "astro:components";

interface Props {
    examples: ResponseExample[];
}

const { examples } = Astro.props;

/* ── Single source of truth for status-family colors ──────────────── */
type FamilyColors = {
    bg: string;     // inactive background
    mid: string;    // inactive border / hover background
    text: string;   // inactive text / hover border
    dark: string;   // hover text
    active: string; // pressed background + border, and the desc accent bar
};

const FAMILY_COLORS: Record<string, FamilyColors> = {
    success:        { bg: "#EAF3DE", mid: "#C0DD97", text: "#3B6D11", dark: "#27500A", active: "#639922" },
    redirect:       { bg: "#E6F1FB", mid: "#B5D4F4", text: "#185FA5", dark: "#0C447C", active: "#378ADD" },
    "client-error": { bg: "#FAECE7", mid: "#F5C4B3", text: "#993C1D", dark: "#712B13", active: "#D85A30" },
    "server-error": { bg: "#FCEBEB", mid: "#F7C1C1", text: "#A32D2D", dark: "#791F1F", active: "#E24B4A" },
    neutral:        { bg: "#F1EFE8", mid: "#D3D1C7", text: "#444441", dark: "#2C2C2A", active: "#5F5E5A" },
};

const FAMILY_KEY: Record<number, string> = {
    2: "success",
    3: "redirect",
    4: "client-error",
    5: "server-error",
};

function colorsFor(example: ResponseExample): FamilyColors {
    const family = getHttpStatusCodeFamily(example.httpStatusCode);
    return FAMILY_COLORS[FAMILY_KEY[family] ?? "neutral"];
}

function pillLabel(example: ResponseExample): string {
    return example.name !== null
        ? `${example.httpStatusCode} ${example.name}`
        : `${example.httpStatusCode}`;
}

/* Emit the inline custom props a pill needs for its base/hover/pressed states. */
function pillVars(c: FamilyColors): string {
    return [
        `--pill-bg:${c.bg}`,
        `--pill-border:${c.mid}`,
        `--pill-text:${c.text}`,
        `--pill-border-hover:${c.text}`,
        `--pill-bg-hover:${c.mid}`,
        `--pill-text-hover:${c.dark}`,
        `--pill-active:${c.active}`,
    ].join(";");
}

const id = `re-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="response-examples-wrap">
    <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.1em] text-stone-500">
        Example responses
    </p>

    <div id={id} class="card overflow-hidden rounded-xl bg-white">
        <!-- Pill strip: pick which status code to show -->
        <div class="pill-strip flex flex-wrap gap-1.5 px-4 py-2.5" role="list" aria-label="Response examples">
            {examples.map((example, index) => {
                const c = colorsFor(example);
                const label = pillLabel(example);
                const statusLabel = getHttpStatusCodeLabel(example.httpStatusCode);
                const familyName = getHttpStatusCodeFamilyLabel(getHttpStatusCodeFamily(example.httpStatusCode));
                return (
                    <button
                        type="button"
                        role="listitem"
                        class="resp-pill inline-flex cursor-pointer items-center whitespace-nowrap rounded-full px-[0.6rem] py-[0.2rem] text-[0.72rem] font-medium leading-[1.4] transition-colors"
                        style={pillVars(c)}
                        data-card={id}
                        data-index={index}
                        aria-pressed={index === 0 ? "true" : "false"}
                        aria-label={`${label} — ${statusLabel}, ${familyName}`}
                        title={`${label}: ${statusLabel}`}
                    >
                        {label}
                    </button>
                );
            })}
        </div>

        <!-- Description rows: one per example, toggled with the pills -->
        {examples.map((example, index) => {
            const c = colorsFor(example);
            const statusLabel = getHttpStatusCodeLabel(example.httpStatusCode);
            const displayName = example.name ?? statusLabel;
            return (
                <div
                    class="desc-row px-4 py-3"
                    data-desc={id}
                    data-index={index}
                    aria-hidden={index !== 0 ? "true" : "false"}
                    style={`--bar:${c.active};${index !== 0 ? "display:none" : ""}`}
                >
                    <div class="mb-1 flex flex-wrap items-center gap-1.5">
                        <span class="font-mono text-[13px] font-medium text-stone-900">{example.httpStatusCode}</span>
                        <span class="text-[13px] text-stone-900/30" aria-hidden="true">·</span>
                        <span class="text-[13px] font-medium text-stone-900">{statusLabel} -</span>
                        <span class="text-[13px] font-medium text-stone-900">{displayName}</span>
                        <span class="sr-only">{example.name}</span>
                    </div>
                    <p class="text-[13px] leading-[1.625] text-stone-600">{example.description}</p>
                </div>
            );
        })}

        <!-- Body / Headers tabs -->
        <div class="resp-tabs">
            <div class="tab-list flex" role="tablist" aria-label="Response format">
                <button
                    type="button"
                    role="tab"
                    id={`${id}-tab-body`}
                    class="resp-tab -mb-[0.5px] cursor-pointer border-b-2 border-transparent px-4 py-[0.4rem] text-xs font-medium text-stone-500 transition-colors hover:text-stone-900 aria-selected:border-stone-900 aria-selected:text-stone-900"
                    data-tab={id}
                    data-panel="body"
                    aria-selected="true"
                    aria-controls={`${id}-panel-body`}
                >Body</button>
                <button
                    type="button"
                    role="tab"
                    id={`${id}-tab-headers`}
                    class="resp-tab -mb-[0.5px] cursor-pointer border-b-2 border-transparent px-4 py-[0.4rem] text-xs font-medium text-stone-500 transition-colors hover:text-stone-900 aria-selected:border-stone-900 aria-selected:text-stone-900"
                    data-tab={id}
                    data-panel="headers"
                    aria-selected="false"
                    aria-controls={`${id}-panel-headers`}
                >Headers</button>
            </div>

            <div
                role="tabpanel"
                id={`${id}-panel-body`}
                data-tab-panel={id}
                data-panel="body"
                aria-labelledby={`${id}-tab-body`}
            >
                {examples.map((example, index) => (
                    <div
                        data-body={id}
                        data-index={index}
                        aria-hidden={index !== 0 ? "true" : "false"}
                        style={index !== 0 ? "display:none" : ""}
                    >
                        {example.body !== null ? (
                            <Code code={example.body.content} lang={example.body.type === "json" ? "json" : "text"} theme="min-light" />
                        ) : (
                            <p class="bg-stone-50 px-4 py-3.5 text-[13px] italic text-stone-400" aria-live="polite">
                                No body returned for {example.httpStatusCode} responses.
                            </p>
                        )}
                    </div>
                ))}
            </div>

            <!-- Inactive panel is hidden inline so it never flashes before JS runs -->
            <div
                role="tabpanel"
                id={`${id}-panel-headers`}
                data-tab-panel={id}
                data-panel="headers"
                aria-labelledby={`${id}-tab-headers`}
                style="display:none"
            >
                {examples.map((example, index) => (
                    <div
                        data-headers={id}
                        data-index={index}
                        aria-hidden={index !== 0 ? "true" : "false"}
                        style={index !== 0 ? "display:none" : ""}
                    >
                        <Code code={example.headers} lang="text" theme="min-light" />
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>

<style>
    /* Hairline tokens (currentColor-based, theme-agnostic) */
    .response-examples-wrap {
        --re-hairline: color-mix(in srgb, currentColor 15%, transparent);
        --re-tint:     color-mix(in srgb, currentColor 4%, transparent);
    }

    /* Hairline separators */
    .card       { border: 0.5px solid var(--re-hairline); }
    .pill-strip { background: var(--re-tint); border-bottom: 0.5px solid var(--re-hairline); }
    .tab-list   { border-bottom: 0.5px solid var(--re-hairline); }
    .desc-row   { border-bottom: 0.5px solid var(--re-hairline); border-left: 3px solid var(--bar); }

    /* Status pill — colors come from the inline --pill-* vars */
    .resp-pill {
        border: 0.5px solid var(--pill-border);
        background: var(--pill-bg);
        color: var(--pill-text);
    }
    .resp-pill:hover {
        border-color: var(--pill-border-hover);
        background: var(--pill-bg-hover);
        color: var(--pill-text-hover);
    }
    .resp-pill[aria-pressed="true"],
    .resp-pill[aria-pressed="true"]:hover {
        border-color: var(--pill-active);
        background: var(--pill-active);
        color: #fff;
    }
</style>

<script>
    type El = HTMLElement;

    function nextIndex(e: KeyboardEvent, current: number, length: number): number | null {
        if (e.key === "ArrowRight") return Math.min(current + 1, length - 1);
        if (e.key === "ArrowLeft")  return Math.max(current - 1, 0);
        return null;
    }

    function initResponseExamples(card: El) {
        const id = card.id;
        const find = (attr: string) =>
            Array.from(card.querySelectorAll<El>(`[${attr}="${id}"]`));

        /* Which status-code example is shown (driven by the pills) */
        const pills  = find("data-card");
        const groups = [find("data-desc"), find("data-body"), find("data-headers")];

        const showExample = (index: number) => {
            pills.forEach((pill, i) => pill.setAttribute("aria-pressed", String(i === index)));
            groups.forEach((group) =>
                group.forEach((el, i) => {
                    el.style.display = i === index ? "" : "none";
                    el.setAttribute("aria-hidden", String(i !== index));
                }),
            );
        };

        /* Which panel is shown (Body vs Headers) */
        const tabs   = find("data-tab");
        const panels = find("data-tab-panel");

        const showPanel = (name: string) => {
            tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.panel === name)));
            panels.forEach((panel) => {
                panel.style.display = panel.dataset.panel === name ? "" : "none";
            });
        };

        pills.forEach((pill, i) => {
            pill.addEventListener("click", () => showExample(i));
            pill.addEventListener("keydown", (e) => {
                const target = nextIndex(e, i, pills.length);
                if (target === null) return;
                e.preventDefault();
                showExample(target);
                pills[target].focus();
            });
        });

        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => showPanel(tab.dataset.panel ?? "body"));
            tab.addEventListener("keydown", (e) => {
                const target = nextIndex(e, i, tabs.length);
                if (target === null) return;
                e.preventDefault();
                showPanel(tabs[target].dataset.panel ?? "body");
                tabs[target].focus();
            });
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        document
            .querySelectorAll<HTMLElement>(".response-examples-wrap .card[id]")
            .forEach(initResponseExamples);
    });
</script>
