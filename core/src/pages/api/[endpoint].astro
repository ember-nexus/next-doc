---
// Moved from [group]/[endpoint].astro to api/[endpoint].astro.
// Endpoint ids are unique, so `group` no longer needs to be in the URL — it is
// used only to group items in the sidebar.
import SwaggerParser from '@apidevtools/swagger-parser';
import { getCollection, render } from 'astro:content';

import RequestBodyCard from "../../component/RequestBodyCard.astro";
import RequestCard from '../../component/RequestCard.astro';
import RequestHeaderCard from '../../component/RequestHeaderCard.astro';
import RequestParameterCard from '../../component/RequestParameterCard.astro';
import ResponseCard from '../../component/ResponseCard.astro';
import ResponseHeaderCard from '../../component/ResponseHeaderCard.astro';
import Default from '../../layouts/Default.astro';
import { endpointParam } from '../../lib';
import {
    extractHarExample,
    extractRequestBody,
    extractRequestHeaders,
    extractRequestParameters,
    extractResponseExamples,
    extractResponseHeaders,
} from '../../util';

export async function getStaticPaths() {
    const entries = await getCollection('endpoints');
    return entries.map((entry) => ({
        // Same helper the sidebar uses for hrefs.
        params: { endpoint: endpointParam(entry.data.endpoint) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { endpoint, method, endpointUrl, swaggerUrl, name } = entry.data;

// NOTE: '/{uuid}' / 'get' are placeholders carried over from the original file.
// Swap these for values derived from `entry.data` once your swagger paths line up.
const spec = await SwaggerParser.dereference('./src/data/swagger.json');

const path = swaggerUrl ?? '/';
const method2 = swaggerUrl == null ? 'get' : method;

const request = extractHarExample(spec, path, method2);
const requestParameters = extractRequestParameters(spec, path, method2);
const requestHeaders = extractRequestHeaders(spec, path, method2);
const requestBody = extractRequestBody(spec, path, method2);
const responseHeaders = extractResponseHeaders(spec, path, method2);
const responseExamples = extractResponseExamples(spec, path, method2);
---

<Default title={`${endpoint} — ${name}`}>
    <div style={`--c: var(--method-${method.toLowerCase()}, var(--method-put))`}>
        <p class="text-3xl sm:text-4xl mb-2 font-mono">
            <span class="uppercase text-(--c)">{method}</span> {endpointUrl}
        </p>
        <p class="mb-3 text-2xl">{name}</p>
        <div class="w-full border-t border-hairline mb-10"></div>

    </div>
    
    <div class="prose dark:prose-invert">
        <Content />
    </div>

    <RequestCard request={request} />
    <ResponseCard examples={responseExamples} />
    <RequestParameterCard parameters={requestParameters} />
    <RequestHeaderCard headers={requestHeaders} />
    {requestBody && <RequestBodyCard body={requestBody} />}
    <ResponseHeaderCard headers={responseHeaders} />
</Default>

<style>
    .prose,
    .api-doc {
        max-width: 58rem;
        width: 100%;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-inline: 1rem;
    }

    @media (max-width: 50rem) {
        .prose,
        .api-doc {
            padding-inline: 0.75rem;
        }
    }
</style>
