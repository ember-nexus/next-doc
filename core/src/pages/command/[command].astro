---
import { getCollection, render } from 'astro:content';

import Default from '../../layouts/Default.astro';
import { commandParam } from '../../lib';
import TerminalExample from 'src/component/TerminalExample.astro';

export async function getStaticPaths() {
    const entries = await getCollection('commands');
    return entries.map((entry) => ({
        // Same helper the sidebar uses for hrefs.
        params: { command: commandParam(entry.data.command) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings: contentHeadings } = await render(entry);
const { command, helpCommand, helpOutput, exampleCommand, exampleOutput } = entry.data;

const terminalHeadings = [
    ...contentHeadings,
    { depth: 2, slug: 'help',    text: 'Help' },
    { depth: 2, slug: 'example', text: 'Example' },
];
---

<Default title={`${command} command`} headings={terminalHeadings}>
    <h1 class="font-mono font-medium">{command}</h1>

    <div class="prose dark:prose-invert">
        <Content />

        <TerminalExample
            file={`src/data/command-output/${helpOutput}`}
            command={helpCommand}
            label="Help"
            id="help"
        />

        <TerminalExample
            file={`src/data/command-output/${exampleOutput}`}
            command={exampleCommand}
            label="Example"
            id="example"
        />
    </div>
</Default>

<style>
    .prose,
    .api-doc {
        max-width: 58rem;
        width: 100%;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-inline: 1rem;
    }

    @media (max-width: 50rem) {
        .prose,
        .api-doc {
            padding-inline: 0.75rem;
        }
    }
</style>
