---
import {getCollection, render} from 'astro:content';
import {getChangesByFeatureUpToVersion} from "../../../repository";
import {marked} from "marked";
import SwaggerParser from '@apidevtools/swagger-parser';
import Default from "../../../layouts/Default.astro";
import ResponseCard from "../../../component/ResponseCard.astro";
import RequestCard from "../../../component/RequestCard.astro";
import RequestHeaderCard from "../../../component/RequestHeaderCard.astro";
import ResponseHeaderCard from "../../../component/ResponseHeaderCard.astro";
import {extractHarExample, extractRequestHeaders, extractResponseExamples, extractResponseHeaders} from "../../../util";
import Sidebar from "../../../component/Sidebar.astro";

export async function getStaticPaths() {
    const entries = await getCollection('endpoints');

    return entries.map((entry) => ({
        params: {
            release_version: entry.data.release_version,
            endpoint: entry.data.endpoint.replace(/\//g, '_'),
            group: entry.data.group
        },
        props: {entry},
    }));
}

const {entry} = Astro.props;
const {Content} = await render(entry);
const {release_version} = entry.data;

const changes = await getChangesByFeatureUpToVersion('api:get-element', release_version);
const changesHtml = await marked.parse(
    changes.map(({title, version}) => `- ${title} (${version})`).join('\n')
);

const spec = await SwaggerParser.dereference('./src/data/swagger/0.1.31.json');

const request = extractHarExample(spec, '/{uuid}', 'get');
const responseExamples = extractResponseExamples(spec, '/{uuid}', 'get');
const requestHeaders = extractRequestHeaders(spec, '/{uuid}', 'get');
const responseHeaders = extractResponseHeaders(spec, '/{uuid}', 'get');
---
<Default title={`${entry.data.endpoint} at version ${release_version}`}>
    <Sidebar version={release_version} />
    <div class="prose dark:prose-invert">
        <h1>{entry.data.endpoint}</h1>
        <p>Release: {release_version} | Version: {entry.data.endpoint_version}</p>
        
        <Content/>
    </div>

    <div class="api-doc mt-3 mb-3 flex flex-col gap-4">
        <RequestCard request={request} />
        <ResponseCard examples={responseExamples} />
        <RequestHeaderCard headers={requestHeaders}/>
        <ResponseHeaderCard headers={responseHeaders}/>
    </div>
    
    <div class="prose dark:prose-invert">
        <h3>History</h3>
        <Fragment set:html={changesHtml}/>
    </div>
</Default>

<style>
    .prose,
    .api-doc {
        max-width: 58rem;
        width: 100%;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-inline: 1rem;
    }

    @media (max-width: 50rem) {
        .prose,
        .api-doc {
            padding-inline: 0.75rem;
        }
    }
</style>