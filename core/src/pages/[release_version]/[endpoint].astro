---
<Default title={`${entry.data.endpoint} at version ${release_version}`}>
    <div class="prose">
        <h1>{entry.data.endpoint}</h1>
        <p>Release: {release_version} | Version: {entry.data.endpoint_version}</p>

        <h3>History</h3>
        <Fragment set:html={changesHtml} />
    </div>

    <div class="layout mb-4">
        <div class="region-content flex flex-col gap-4">
            <RequestHeaderCard headers={requestHeaders} />
            <ResponseHeaderCard headers={responseHeaders} />
        </div>
        <div class="region-example flex flex-col gap-4">
            <!--<RequestCard request={request} />-->
            <!--<ResponseCard examples={examples} />-->
        </div>
    </div>
    
<Content />
</Default>

<style>
    .layout {
        display: grid;
        grid-template-columns: 50rem 35rem;
        grid-template-areas: "content example";
        gap: 1rem;
        justify-content: center;
    }

    .region-content {
        grid-area: content;
    }

    .region-example {
        grid-area: example;
    }

    @media (max-width: 87rem) { /* 50 + 35 + 1 + some breathing room */
        .layout {
            grid-template-columns: 50rem;
            grid-template-areas:
        "content"
        "example";
        }
    }
</style>