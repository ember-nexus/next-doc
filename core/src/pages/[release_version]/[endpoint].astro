---
import { getCollection, render } from 'astro:content';
import {getChangesByFeatureUpToVersion} from "../../repository/ChangeRepository.ts";
import {marked} from "marked";
import Default from "../../layouts/Default.astro";
import type {HttpStatusCode, Link, RequestHeader, ResponseExample, ResponseHeader} from "../../type";
import ResponseCard from "../../component/ResponseCard.astro";
import type {HarRequest} from "httpsnippet";
import RequestCard from "../../component/RequestCard.astro";
import RequestHeaderCard from "../../component/RequestHeaderCard.astro";
import ResponseHeaderCard from "../../component/ResponseHeaderCard.astro";
import SwaggerParser from '@apidevtools/swagger-parser';
import {OpenAPI} from "openapi-types";
import equal from 'fast-deep-equal/es6';


export async function getStaticPaths() {
    const entries = await getCollection('endpoints');

    // console.log(entries);

    return entries.map((entry) => ({
        params: {
            release_version: entry.data.release_version,
            endpoint: entry.data.endpoint.replace(/\//g, '_'), // sanitize slashes in URL
        },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const release_version = entry.data.release_version;


const changes = await getChangesByFeatureUpToVersion('api:get-element', release_version);

const markdownString = changes
    .map(({ title, version }) => `- ${title} (${version})`)
    .join('\n');

const changesHtml = await marked.parse(markdownString);


const spec = await SwaggerParser.dereference('./src/data/swagger/0.1.31.json');

function getResponseHeaders(spec: OpenAPI.Document, path: string, method: string) {
    const op = (spec.paths?.[path] as any)?.[method];

    const result: { name: string; schema: any; codes: string[] }[] = [];

    for (const [code, res] of Object.entries(op?.responses ?? {}) as any) {
        for (const [name, schema] of Object.entries((res as any)?.headers ?? {})) {
            const existing = result.find(
                (r) => r.name === name && equal(r.schema, schema)
            );
            if (existing) {
                existing.codes.push(code);
            } else {
                result.push({ name, schema, codes: [code] });
            }
        }
    }

    return result;
}

const endpointResponseHeaders = getResponseHeaders(spec, '/{uuid}', 'get');

function getRequestHeaders(spec: OpenAPI.Document, path: string, method: string) {
    const op = (spec.paths?.[path] as any)?.[method];

    return (op?.parameters ?? [])
        .filter((p: any) => p.in === 'header')
        .map(({ in: _, ...rest }: any) => rest);
}

const endpointRequestHeaders = getRequestHeaders(spec, '/{uuid}', 'get');
console.log(endpointRequestHeaders);

let requestHeaders: RequestHeader[] = [];
for (const [_, header] of Object.entries(endpointRequestHeaders)) {
    requestHeaders.push({
        header: header.name,
        presence: header.required ? 'required' : 'optional',
        description: header.description as string,
        links: header['x-ember-nexus-links'] as Link[]
    });
}



let responseHeaders: ResponseHeader[] = [];
for (const [_, header] of Object.entries(endpointResponseHeaders)) {
    responseHeaders.push({
        header: header.name,
        presence: header.schema.required ? 'always' : 'optional',
        important: header.schema['x-ember-nexus-important'] ?? false,
        description: header.schema.description,
        links: header.schema['x-ember-nexus-links']
    });
}



