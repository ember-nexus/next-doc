---
import '../styles/global.css'

import Sidebar from '../component/Sidebar.astro'
import Header from "../component/Header.astro";
import TocNav from '../component/TocNav.astro';
import OverlayPanel from '../component/OverlayPanel.astro';

interface Props {
    title: string
    description?: string
    version?: string
    headings?: { depth: number; slug: string; text: string }[]
}

const { title, description = 'Ember Nexus API', version = 'latest', headings = [] } = Astro.props
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Ember Nexus API" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <!-- Suppress transitions immediately so panels don't animate into position on first paint. -->
    <script is:inline>document.documentElement.classList.add('no-transitions');</script>
    <script defer src="https://analytics.webserver.ember-nexus.dev/script.js" data-website-id="dcc00c41-5a1a-48db-8e4f-59ce8a7fada7"></script>
</head>

<body class="min-h-screen bg-white text-gray-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
<Header />
<Sidebar />

{headings.length > 0 && (
    <OverlayPanel id="toc-panel" side="right" label="Table of contents">
        <TocNav headings={headings} />
    </OverlayPanel>
)}


{headings.length > 0 && (
    /* Desktop fixed TOC — pulled out of the grid so position:fixed works correctly.
       Hidden on mobile; the overlay panel takes over there. */
    <aside class="toc-sidebar" aria-label="Table of contents">
        <TocNav headings={headings} />
    </aside>
)}

<div
    id="main-content"
    class="flex min-h-screen flex-col pt-14 transition-[padding] duration-200 ease-in-out pl-0 sm:pt-16"
>
    <main class="content-grid" data-pagefind-body>
        <slot />
    </main>
</div>

<script>
    import '../component/Lit/index.ts';
</script>

<script>
    // TOC scroll-aware positioning:
    // - At scrollY=0 the TOC starts below the title block (visually grouped with content).
    // - As the page scrolls, the TOC moves up with the content until it hits the
    //   header bottom, then stays stuck there (classic "sticky after threshold").
    //
    // Strategy: position:fixed, update `top` on every scroll frame.
    //   top = clamp(headerH, initialTop - scrollY, initialTop)
    //   where initialTop = document-bottom of title block + row-gap.

    let tocInitialTop = 0; // document-absolute px of the element top — recomputed on load/resize
    let headerH = 64;      // px — recomputed on load/resize

    // Gap between header bottom and first TOC link when the TOC is fully stuck.
    // Must match the padding-top on .toc-sidebar in grid.css.
    const TOC_PADDING_TOP = 16;

    function measureToc() {
        const header = document.querySelector('header');
        const titleBlock = document.querySelector('.page-title-block');
        headerH = header ? header.getBoundingClientRect().height : 64;

        const rowGap = 24; // 1.5rem — matches content-grid row-gap
        if (titleBlock instanceof HTMLElement) {
            // document-absolute bottom of title block + row-gap = where the first link should start.
            // Subtract padding-top so the element top is that far above the first link.
            const firstLinkDocY = titleBlock.getBoundingClientRect().bottom + window.scrollY + rowGap;
            tocInitialTop = firstLinkDocY - TOC_PADDING_TOP;
        } else {
            tocInitialTop = headerH + rowGap - TOC_PADDING_TOP;
        }

        applyTocTop();
    }

    function applyTocTop() {
        // When sticky: element top = headerH, first link lands at headerH + TOC_PADDING_TOP.
        const top = Math.max(headerH, tocInitialTop - window.scrollY);
        const maxH = window.innerHeight - top;
        const toc = document.querySelector<HTMLElement>('.toc-sidebar');
        if (toc) {
            toc.style.top = `${top}px`;
            toc.style.maxHeight = `${maxH}px`;
        }
    }

    function initTocPosition() {
        measureToc();
        window.addEventListener('scroll', applyTocTop, { passive: true });
        window.addEventListener('resize', measureToc, { passive: true });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTocPosition);
    } else {
        initTocPosition();
    }
    document.addEventListener('astro:page-load', initTocPosition);
</script>

<script is:inline>
    // Apply the correct TOC top position synchronously before first paint to prevent
    // layout shift. Mirrors the measureToc() / applyTocTop() logic above, but runs
    // inline so the browser can apply it before rendering the sidebar.
    (function () {
        var TOC_PADDING_TOP = 16;
        var toc = document.querySelector('.toc-sidebar');
        if (!toc) return;
        var header = document.querySelector('header');
        var titleBlock = document.querySelector('.page-title-block');
        var headerH = header ? header.getBoundingClientRect().height : 64;
        var rowGap = 24;
        var tocInitialTop;
        if (titleBlock) {
            var firstLinkDocY = titleBlock.getBoundingClientRect().bottom + window.scrollY + rowGap;
            tocInitialTop = firstLinkDocY - TOC_PADDING_TOP;
        } else {
            tocInitialTop = headerH + rowGap - TOC_PADDING_TOP;
        }
        var top = Math.max(headerH, tocInitialTop - window.scrollY);
        toc.style.top = top + 'px';
        toc.style.maxHeight = (window.innerHeight - top) + 'px';
    })();
</script>

<script>
    // TOC links: header-aware smooth scroll on all viewports.
    // On mobile, also close the TOC overlay first via the event system.
    // Active-section highlighting is handled inside TocNav.astro.
    function initTocClicks() {
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
        if (!tocLinks.length) return;

        const getHeaderHeight = (): number => {
            const header = document.querySelector('header');
            return header ? header.getBoundingClientRect().height : 56;
        };

        tocLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();

                const isMobile = window.matchMedia('(max-width: 768px)').matches;
                if (isMobile) {
                    window.dispatchEvent(new CustomEvent('overlay-close', { detail: { id: 'toc-panel' } }));
                }

                const href = link.getAttribute('href');
                if (!href) return;
                const target = document.getElementById(href.slice(1));
                if (!target) return;

                history.pushState(null, '', href);

                requestAnimationFrame(() => {
                    const top = target.getBoundingClientRect().top + window.scrollY - getHeaderHeight() - 16;
                    window.scrollTo({ top, behavior: 'smooth' });
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTocClicks);
    } else {
        initTocClicks();
    }
    document.addEventListener('astro:page-load', initTocClicks);
</script>


</body>
</html>
