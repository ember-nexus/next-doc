---
import '../styles/global.css'
import Sidebar from '../component/Sidebar.astro'
import SidebarToggle from '../component/SidebarToggle.astro'

interface Props {
    title: string
    description?: string
    version?: string,
    headings?: { depth: number; slug: string; text: string }[]
}

const { title, description = 'Ember Nexus API', version = 'latest', headings = [] } = Astro.props
---

<!doctype html>
<html lang="de" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
</head>

<body
    x-data="{ sidebarOpen: null }"
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
>
<Sidebar version={version} />

<div
    class="flex min-h-screen flex-col transition-[padding] duration-200 ease-in-out max-sm:pl-0 sm:pl-64"
    :class="{ 'sm:pl-64': sidebarOpen !== false, 'sm:!pl-0': sidebarOpen === false }"
>
    <header class="flex items-center gap-2 px-5 py-4">
        <SidebarToggle icon="panel-left" />
    </header>

    <nav>
        <ul>
            {headings
                .filter(h => h.depth <= 3) // only h1–h3
      .map(h => (
                    <li style={`margin-left: ${(h.depth - 1)}rem`}>
                        <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
    
    <main class="mx-auto w-full max-w-screen-xl flex-1 px-5 py-6">
        <slot />
    </main>
</div>
<script>
    import '../component/Graph/index.ts';
</script>
</body>
</html>