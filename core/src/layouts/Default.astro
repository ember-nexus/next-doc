---
import '../styles/global.css'
import Sidebar from '../component/Sidebar.astro'
import SidebarToggle from '../component/SidebarToggle.astro'
import Search from "astro-pagefind/components/Search.astro";

interface Props {
    title: string
    description?: string
    version?: string
    headings?: { depth: number; slug: string; text: string }[]
}

const { title, description = 'Ember Nexus API', version = 'latest', headings = [] } = Astro.props
---

<!doctype html>
<html lang="de" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MyWebSite" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
</head>

<body
    x-data="{ sidebarOpen: null }"
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
>
<Sidebar version={version} />

<div
    class="flex min-h-screen flex-col transition-[padding] duration-200 ease-in-out max-sm:pl-0 sm:pl-64"
    :class="{ 'sm:pl-64': sidebarOpen !== false, 'sm:!pl-0': sidebarOpen === false }"
>
    <header class="flex items-center gap-2 px-5 py-4">
        <SidebarToggle icon="panel-left" />
        <Search instance="search" className="pagefind-ui" searchboxOptions={{ placeholder: "search" }} />
    </header>

    <main class="content-grid" data-pagefind-body>
        {headings.length > 0 && (
            <aside class="toc-sidebar" aria-label="Table of contents">
                <nav class="toc-nav">
                    <ul>
                        {headings
                            .filter(h => h.depth <= 3)
                            .map(h => (
                                <li style={`margin-left: ${(h.depth - 1) * 0.75}rem`}>
                                    <a href={`#${h.slug}`}>{h.text}</a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>
            </aside>
        )}

        <slot />
    </main>
</div>

<script>
    import '../component/Lit/index.ts';
</script>
</body>
</html>
