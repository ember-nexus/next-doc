---
import '../styles/global.css'

import Sidebar from '../component/Sidebar.astro'
import Header from "../component/Header.astro";
import TocNav from '../component/TocNav.astro';
import { Icon } from 'astro-icon/components';

interface Props {
    title: string
    description?: string
    version?: string
    headings?: { depth: number; slug: string; text: string }[]
}

const { title, description = 'Ember Nexus API', version = 'latest', headings = [] } = Astro.props
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Ember Nexus API" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script defer src="https://analytics.webserver.ember-nexus.dev/script.js" data-website-id="dcc00c41-5a1a-48db-8e4f-59ce8a7fada7"></script>
</head>

<body
    x-data="{ sidebarOpen: null, tocOpen: null }"
    class="min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
>
<Header />
<Sidebar version={version} />

{headings.length > 0 && (
    /* Mobile-only overlay panel — hidden on desktop via sm:hidden */
    <aside
        id="toc-panel"
        class="fixed bottom-0 right-0 top-14 z-40 flex h-[calc(100dvh-3.5rem)] w-full flex-col bg-white transition-transform duration-200 ease-in-out translate-x-full dark:bg-gray-950 sm:hidden print:hidden"
        :class="{ '!translate-x-0': tocOpen === true, '!translate-x-full': tocOpen === false }"
        aria-label="Table of contents"
    >
        <button
            type="button"
            @click="tocOpen = false"
            aria-label="Close table of contents"
            class="absolute right-4 top-4 z-50 inline-flex items-center justify-center rounded-md p-2 text-gray-700 transition hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 dark:text-gray-200 dark:hover:bg-gray-800"
        >
            <Icon name="x" class="size-4" />
        </button>
        <div class="flex-1 overflow-y-auto overscroll-contain p-4">
            <TocNav headings={headings} />
        </div>
    </aside>
)}

<div
    class="flex min-h-screen flex-col pt-14 transition-[padding] duration-200 ease-in-out max-sm:pl-0 sm:pl-64 sm:pt-16"
    :class="{ 'sm:pl-64': sidebarOpen !== false, 'sm:!pl-0': sidebarOpen === false }"
>
    <main class="content-grid" data-pagefind-body>
        {headings.length > 0 && (
            /* Desktop inline sticky TOC — hidden on mobile, the fixed panel takes over there */
            <aside class="toc-sidebar" aria-label="Table of contents">
                <TocNav headings={headings} />
            </aside>
        )}

        <slot />
    </main>
</div>

<script>
    import '../component/Lit/index.ts';
</script>

<script>
    // TOC links: header-aware smooth scroll on all viewports.
    // On mobile, also close the overlay first.
    // Active-section highlighting is handled inside TocNav.astro.
    function initTocClicks() {
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
        if (!tocLinks.length) return;

        const getHeaderHeight = (): number => {
            const header = document.querySelector('header');
            return header ? header.getBoundingClientRect().height : 56;
        };

        tocLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();

                const isMobile = window.matchMedia('(max-width: 768px)').matches;
                if (isMobile) {
                    const alpine = (window as any).Alpine;
                    if (alpine) {
                        const data = alpine.$data(document.body);
                        if (data) data.tocOpen = false;
                    }
                }

                const href = link.getAttribute('href');
                if (!href) return;
                const target = document.getElementById(href.slice(1));
                if (!target) return;

                // Update the URL hash without triggering a jump (replaceState keeps history clean).
                history.pushState(null, '', href);

                requestAnimationFrame(() => {
                    const top = target.getBoundingClientRect().top + window.scrollY - getHeaderHeight() - 16;
                    window.scrollTo({ top, behavior: 'smooth' });
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTocClicks);
    } else {
        initTocClicks();
    }
    document.addEventListener('astro:page-load', initTocClicks);
</script>
</body>
</html>
