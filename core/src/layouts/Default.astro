---
import '../styles/global.css'
import Sidebar from '../component/Sidebar.astro'
import SidebarToggle from '../component/SidebarToggle.astro'

interface Props {
    title: string
    description?: string
    version?: string
}

const { title, description = 'Ember Nexus API', version = '0.1.31' } = Astro.props
---

<!doctype html>
<html lang="de" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
</head>

<body
    x-data="{ sidebarOpen: true }"
    class="flex min-h-screen bg-white text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100"
>
<Sidebar version={version} />

<div class="flex min-w-0 flex-1 flex-col">
    <header class="flex items-center gap-2 px-5 py-4">
        <SidebarToggle icon="panel-left" />
    </header>

    <main class="mx-auto w-full max-w-screen-xl flex-1 px-5 py-6">
        <slot />
    </main>
</div>
</body>
</html>